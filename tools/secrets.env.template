# Robot secrets - /root/robot/data/secrets.env (never committed; file mode 600).
# Fill in what you have, leave the rest empty, then:  systemctl restart robotd
# (The web app's AI and Social tabs can also store keys; those override this file.)

# --- AI brains ---
ANTHROPIC_API_KEY=           # console.anthropic.com > API keys  (Claude Opus/Sonnet/Haiku brain + self-improvement agent)
OPENROUTER_API_KEY=          # openrouter.ai > Keys  (any model; add model ids in the web app AI tab)

# --- Social ---
BLUESKY_HANDLE=              # e.g. myrobot.bsky.social
BLUESKY_APP_PASSWORD=        # Bluesky > Settings > Privacy and security > App passwords (NOT your login password)
PINTEREST_TOKEN=             # Pinterest developer app access token with pins:write, boards:read
PINTEREST_BOARD_ID=          # numeric id of the board to pin to

# --- GitHub (your own repo or fork; pushing uses the robot's deploy key, this token is only for downloading CI firmware) ---
GITHUB_REPO=                 # owner/name of YOUR repo, e.g. yourname/my-robot
GITHUB_TOKEN=                # fine-grained token: that repo only, permission "Actions: read"

# --- Remote access ---
CLOUDFLARE_TUNNEL_TOKEN=     # Cloudflare Zero Trust > Networks > Tunnels > create > copy the connector token
                             # (then: install cloudflared and run  cloudflared service install $CLOUDFLARE_TUNNEL_TOKEN)
